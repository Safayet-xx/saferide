# Copy this file to .env and fill in real values. .env is git-ignored; this file is committed.
# run.bat creates .env from this file automatically on first run.

# ---- App ----
APP_ENV=development
# Long random string. Send it as the x-admin-key header to GET /api/quotes and /api/messages
ADMIN_KEY=change-me
# Show FastAPI docs at /docs (keep false in production)
ENABLE_API_DOCS=true

# ---- Email (SendGrid) ----
# sendgrid = real emails. console = emails are only printed in the backend window (local testing).
# Leave empty to use sendgrid when SENDGRID_API_KEY is set, otherwise console.
EMAIL_PROVIDER=
# SendGrid > Settings > API Keys (needs "Mail Send" permission)
SENDGRID_API_KEY=
# Must be verified in SendGrid (Settings > Sender Authentication)
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SafeRide Airport Taxis
# Inbox(es) that receive every booking and message. Comma-separated for more than one.
BOOKINGS_EMAIL_TO=
# Email the customer a confirmation with their reference
SEND_CUSTOMER_CONFIRMATION=true
# Pickup times are treated as this timezone (used to reject past bookings)
TIMEZONE=Europe/London

# ---- Local ports (used by run.bat and vite.config.js) ----
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
# Comma-separated origins allowed to call the API from another port. Leave empty in production.
CORS_ORIGINS=http://localhost:5173

# ---- Brand (shown across the website) ----
BRAND_NAME=SafeRide Airport Taxis
BRAND_LEGAL_NAME=SafeRide Airport Taxis Limited
BRAND_TAGLINE=Airport transfers, day and night.
BRAND_PHONE=01234 567890
BRAND_WHATSAPP=01234 567890
BRAND_EMAIL=hello@example.com
BRAND_ADDRESS=1 Example Street, Your Town, AB1 2CD

# ---- Links (use # until you have them) ----
APP_LINK_IOS=#
APP_LINK_ANDROID=#
SOCIAL_FACEBOOK=#
SOCIAL_INSTAGRAM=#
SOCIAL_X=#
SOCIAL_LINKEDIN=#
SOCIAL_TIKTOK=#
